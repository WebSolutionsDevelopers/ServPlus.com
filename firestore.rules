rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'juliano.jcavalheiro@gmail.com'
      );
    }

    // Regra da subcoleção de serviços organizada por mês: usuarios/{userId}/meses/{anoMes}/servicos/{servicoId}
    match /usuarios/{userId}/meses/{anoMes}/servicos/{servicoId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Regra do documento agregador de mês: usuarios/{userId}/meses/{anoMes}
    match /usuarios/{userId}/meses/{anoMes} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Regra da subcoleção de serviços por usuário (legada/compatibilidade direta)
    match /usuarios/{userId}/servicos/{servicoId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Suporte a collectionGroup('servicos') para consulta consolidada do administrador
    match /{path=**}/servicos/{servicoId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // Documento de perfil do usuário e configurações
    match /usuarios/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Permissão para coleção raiz legada (necessário para ler/mover durante migração)
    match /servicos/{servicoId} {
      allow read, write: if isSignedIn();
    }

    match /config/{configId} {
      allow read, write: if isSignedIn();
    }
  }
}

